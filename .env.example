# Contact Modal — Supabase + Resend
# Copy to .env and fill in your values

# Supabase (Project URL and anon key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (Server-only — never expose to client)
RESEND_API_KEY=re_your-resend-api-key
CONTACT_EMAIL_TO=your-email@example.com
# Sender shown in email headers. Default (if unset): "Tomás Gómez <on@resend.dev>"
# — Resend's sandbox, which only delivers to your own account email.
# Once your domain is fully verified (MX + DKIM + SPF), set e.g.:
# EMAIL_FROM="Tomás Gómez <contact@gomeztomasgonzalo.com.ar>"

# Public site URL (used in email links)
PUBLIC_SITE_URL=https://your-domain.com