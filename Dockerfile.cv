# Image for containerized CV PDF generation (scripts/cv-pdf-docker.mjs).
# Ships a Chromium-class browser so `scripts/build-cv.mjs` runs with no
# Chrome/Edge installed on the host. The repo is bind-mounted at /work at
# run time, so the image is independent of the host's node_modules.
FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       chromium \
       fonts-liberation \
       ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# CV fonts are baked into the image (versions pinned to the repo lockfile) so
# the rendered PDF never depends on the host's node_modules. Without them the
# renderer silently falls back to Liberation/DejaVu system fonts, which changes
# the typography without raising any error.
ENV CV_FONT_ROOT=/opt/cv-fonts/node_modules/@fontsource

RUN npm install --prefix /opt/cv-fonts --no-audit --no-fund --loglevel=error \
      @fontsource/inter@5.3.0 \
      @fontsource/cormorant-garamond@5.3.0 \
  && npm cache clean --force

# Defaults so a bare `docker run` works; callers may override either.
# Chromium needs --no-sandbox inside unprivileged containers (no user
# namespaces) and --disable-dev-shm-usage because /dev/shm is tiny (64 MB).
ENV EDGE_PATH=/usr/bin/chromium \
    EDGE_EXTRA_ARGS="--no-sandbox --disable-dev-shm-usage"

WORKDIR /work
ENTRYPOINT ["node", "scripts/build-cv.mjs"]
