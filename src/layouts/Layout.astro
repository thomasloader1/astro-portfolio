---
// Font diet — weight/subset-specific imports only (8 woff2 total).
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/roboto-mono/latin-400.css";
import "@fontsource/roboto-mono/latin-500.css";
import "@fontsource/roboto-mono/latin-600.css";
import "@fontsource/cormorant-garamond/latin-300-italic.css";
import i18next, { t } from "i18next";
import { cvData } from "../../scripts/cv-data.mjs";

interface Props {
	title: string;
	description: string;
	/** Error pages: keep them out of the index and skip canonical/hreflang. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Client-side strings: only the contact modal needs them (src/scripts/site.ts).
const bundle = i18next.getResourceBundle(i18next.language, "translation") ?? {};
const resources = { contact: { modal: bundle.contact?.modal ?? {} } };

// --- Technical SEO (canonical, hreflang, Open Graph, Twitter, JSON-LD) ---
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? "https://gomeztomasgonzalo.com.ar").replace(/\/+$/, "");
const pathname = Astro.url.pathname;

// Root `/` and `/en/` keep their trailing slash; every other path drops it.
const isRoot = pathname === "/" || pathname === "/en/";
const canonicalUrl = siteUrl + (isRoot ? pathname : pathname.replace(/\/+$/, ""));

// Locale variants — es lives at the root, en under `/en`.
const esPath = pathname.startsWith("/en") ? (pathname === "/en/" ? "/" : pathname.slice(3)) : pathname;
const esUrl = siteUrl + (esPath === "/" ? "/" : esPath.replace(/\/+$/, ""));
const enUrl = siteUrl + (esPath === "/" ? "/en/" : "/en" + esPath.replace(/\/+$/, ""));

// es_AR: the Spanish copy uses voseo and targets Argentina / LATAM, not Spain.
const ogLocale = i18next.language === "en" ? "en_US" : "es_AR";
const ogLocaleAlternate = i18next.language === "en" ? "es_AR" : "en_US";
// PNG, not SVG: LinkedIn, Facebook, X and WhatsApp don't render SVG previews.
// Regenerate with `pnpm build:icons` after editing public/og-image.svg.
const ogImageUrl = siteUrl + "/og-image.png";
const ogImageAlt = `${t("hero.name")} — ${t("hero.role")}`;

// Person schema only on the landing pages (excludes the 404 error pages).
const isLanding = pathname === "/" || pathname === "/en/";
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: t("hero.name"),
	url: canonicalUrl,
	jobTitle: t("hero.role"),
	image: cvData.photoUrl,
	email: `mailto:${cvData.email}`,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Buenos Aires",
		addressCountry: "AR",
	},
	// Core stack only — the stack the hero and services pitch, not every tool
	// from older roles (Rundeck, jQuery, Windows…).
	knowsAbout: [".NET", "C#", "React", "TypeScript", "Next.js", "Laravel", "PHP", "Node.js", "SQL Server", "MySQL", "AWS", "REST APIs"],
	knowsLanguage: ["es", "en"],
	sameAs: [cvData.linkedin, cvData.github],
};
---

<!doctype html>
<html lang={i18next.language}>
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(function() {
				var root = document.documentElement;
				// Test palette: ?theme=teal turns it on for this tab (survives es/en
				// navigation), ?theme=default turns it off. Not exposed in the UI.
				try {
					var param = new URLSearchParams(location.search).get('theme');
					if (param === 'teal') sessionStorage.setItem('palette', 'teal');
					if (param === 'default') sessionStorage.removeItem('palette');
					if (sessionStorage.getItem('palette') === 'teal') {
						root.setAttribute('data-theme', 'teal');
						return; // light-only theme: skip dark mode
					}
				} catch (e) {}
				var theme = localStorage.getItem('theme');
				if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					root.classList.add('dark');
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={t(description)} />
		<meta name="color-scheme" content="light dark" />
		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<>
				<link rel="canonical" href={canonicalUrl} />
				<link rel="alternate" hreflang="es" href={esUrl} />
				<link rel="alternate" hreflang="en" href={enUrl} />
				<link rel="alternate" hreflang="x-default" href={esUrl} />
			</>
		)}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={t("hero.name")} />
		<meta property="og:title" content={t(title)} />
		<meta property="og:description" content={t(description)} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={t(title)} />
		<meta name="twitter:description" content={t(description)} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
		<link rel="stylesheet" href="/landing.css" />
		<title>{t(title)}</title>
		{isLanding && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		)}
	</head>
	<body>
		<a class="skip-link" href="#main">{t("nav.skip")}</a>
		<slot />
		<script>
			import "../scripts/site";
		</script>
		<script is:inline define:vars={{ resources }}>
			window.__i18n = resources;
		</script>
	</body>
</html>
