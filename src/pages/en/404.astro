---
import { changeLanguage } from "i18next";
import Layout from "../../layouts/Layout.astro";

changeLanguage("en");
---

<Layout title="site.title" description="site.description">
  <main id="main" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div class="container" style="text-align: center;">
      <h1 style="font-size: clamp(4rem, 12vw, 8rem); color: var(--accent); margin-bottom: var(--space-4);">404</h1>
      <p style="font-size: var(--text-lg); color: var(--fg-2); margin-bottom: var(--space-8);">The page you're looking for doesn't exist.</p>
      <a href="/en/" class="btn btn-primary">Go back home</a>
    </div>
  </main>
</Layout>
