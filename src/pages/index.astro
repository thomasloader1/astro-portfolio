---
import { changeLanguage } from "i18next";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Proyects from "../components/Proyects.astro";
import Contact from "../components/sections/Contact.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

changeLanguage("es");
---

<Layout title="site.title" description='site.description'>
	<Header />
	<main>
		<Hero />
		<SectionContainer id="services" class="py-24" content={Services} />
		<Process />
		<Testimonials />
		<SectionContainer id="experience" class="py-24" content={Experience} />
		<SectionContainer id="proyects" class="pb-24" content={Proyects} />
		<Contact />
	</main>
	<Footer />
</Layout>