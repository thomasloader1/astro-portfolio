---
import i18next, { t } from "i18next";
import {
  siDotnet,
  siCsharp,
  siReact,
  siTypescript,
  siMicrosoftsqlserver,
  siLaravel,
  siPhp,
  siNextdotjs,
  siPython,
  siMysql,
  siLinux,
  siCakephp,
  siWordpress,
  siJquery,
  siAmazonwebservices,
  siJavascript,
  siGnubash,
  siRundeck,
  siWindows,
} from "simple-icons";

interface Role {
  titleKey: string;
  company: string;
  contextKey: string;
  coreKey: string;
  start: string;
  end: string | null;
  techs: string[];
}

const roles: Role[] = [
  {
    titleKey: "exp.r1Title",
    company: "Solutica",
    contextKey: "exp.r1Context",
    coreKey: "exp.r1Core",
    start: "2024-09",
    end: null,
    techs: [".NET Core 8", "C#", "React", "TypeScript", "SQL Server"],
  },
  {
    titleKey: "exp.r2Title",
    company: "Medical & Scientific Knowledge",
    contextKey: "exp.r2Context",
    coreKey: "exp.leadCore",
    start: "2023-10",
    end: "2024-09",
    techs: ["Laravel", "PHP", "Next.js", "React", "TypeScript", "Python", "MySQL", "Linux"],
  },
  {
    titleKey: "exp.r3Title",
    company: "Océano Medicina",
    contextKey: "exp.r3Context",
    coreKey: "exp.leadCore",
    start: "2022-01",
    end: "2023-10",
    techs: ["Laravel", "PHP", "CakePHP", "React", "WordPress", "MySQL", "Linux"],
  },
  {
    titleKey: "exp.r4Title",
    company: "Anteojos Negros",
    contextKey: "exp.r4Context",
    coreKey: "exp.r4Core",
    start: "2021-03",
    end: "2022-01",
    techs: ["PHP", "Slim Framework", "JavaScript", "jQuery", "AWS", "MySQL"],
  },
  {
    titleKey: "exp.r5Title",
    company: "Frávega",
    contextKey: "exp.r5Context",
    coreKey: "exp.r5Core",
    start: "2020-03",
    end: "2021-08",
    techs: ["Bash", "Rundeck", "Linux", "Windows"],
  },
];

// simple-icons dropped some brand icons in newer releases (C#, SQL Server,
// AWS, Windows), so the version is pinned to 12.4.0 which still ships them.
// Slim Framework has no simple-icons entry at all — it renders text-only.
const TECH_ICONS: Record<string, { path: string }> = {
  ".NET Core 8": siDotnet,
  "C#": siCsharp,
  React: siReact,
  TypeScript: siTypescript,
  "SQL Server": siMicrosoftsqlserver,
  Laravel: siLaravel,
  PHP: siPhp,
  "Next.js": siNextdotjs,
  Python: siPython,
  MySQL: siMysql,
  Linux: siLinux,
  CakePHP: siCakephp,
  WordPress: siWordpress,
  jQuery: siJquery,
  AWS: siAmazonwebservices,
  JavaScript: siJavascript,
  Bash: siGnubash,
  Rundeck: siRundeck,
  Windows: siWindows,
};

const dateFmt = new Intl.DateTimeFormat(i18next.language, { month: "short", year: "numeric" });
const fmt = (ym: string): string => dateFmt.format(new Date(`${ym}-01T00:00:00`));
---

<section id="experience" aria-labelledby="exp-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t("exp.eyebrow")}</span>
      <h2 id="exp-title">{t("exp.title")}</h2>
    </div>
    <ol class="timeline" role="list">
      {roles.map((role) => (
        <li class="tl-item">
          <div class="tl-date">{fmt(role.start)} — {role.end ? fmt(role.end) : t("exp.present")}</div>
          <div class="tl-role">
            <div class="top">
              <h3>{t(role.titleKey)}</h3>
              <span class="company">{role.company}</span>
            </div>
            <p class="company-context">{t(role.contextKey)}</p>
            <p class="role-core">{t(role.coreKey)}</p>
          </div>
          <div class="tl-stack">
            <h4 class="tl-stack-title">{t("exp.stack")}</h4>
            <ul class="tl-stack-list" role="list">
              {role.techs.map((tech) => {
                const icon = TECH_ICONS[tech];
                return (
                  <li class="tl-stack-item">
                    {icon && (
                      <svg class="tl-stack-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d={icon.path} />
                      </svg>
                    )}
                    <span>{tech}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
