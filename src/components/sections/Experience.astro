---
import i18next, { t } from "i18next";
import {
  siDotnet,
  siCsharp,
  siReact,
  siTypescript,
  siMicrosoftsqlserver,
  siLaravel,
  siPhp,
  siNextdotjs,
  siPython,
  siMysql,
  siLinux,
  siCakephp,
  siWordpress,
  siJquery,
  siAmazonwebservices,
  siJavascript,
  siGnubash,
  siRundeck,
  siWindows,
} from "simple-icons";
import { cvData } from "../../../scripts/cv-data.mjs";

// Single source of truth: the same data feeds the CV PDF (scripts/build-cv.mjs).
const roles = cvData.experienceMeta.map((meta) => ({
  titleKey: `exp.${meta.id}Title`,
  contextKey: `exp.${meta.id}Context`,
  coreKey: meta.coreKey ?? `exp.${meta.id}Core`,
  company: meta.company,
  start: meta.start,
  end: meta.end,
  techs: meta.techs,
}));

// simple-icons dropped some brand icons in newer releases (C#, SQL Server,
// AWS, Windows), so the version is pinned to 12.4.0 which still ships them.
// Slim Framework has no simple-icons entry at all — it renders text-only.
const TECH_ICONS: Record<string, { path: string }> = {
  ".NET Core 8": siDotnet,
  "C#": siCsharp,
  React: siReact,
  TypeScript: siTypescript,
  "SQL Server": siMicrosoftsqlserver,
  Laravel: siLaravel,
  PHP: siPhp,
  "Next.js": siNextdotjs,
  Python: siPython,
  MySQL: siMysql,
  Linux: siLinux,
  CakePHP: siCakephp,
  WordPress: siWordpress,
  jQuery: siJquery,
  AWS: siAmazonwebservices,
  JavaScript: siJavascript,
  Bash: siGnubash,
  Rundeck: siRundeck,
  Windows: siWindows,
};

// Progressive disclosure: the first sentence is always visible, the rest sits
// behind a native <details>. Copy is unchanged (the CV PDF uses the full text).
const splitLead = (text: string): { lead: string; rest: string } => {
  const cut = text.indexOf(". ");
  return cut > 0 ? { lead: text.slice(0, cut + 1), rest: text.slice(cut + 2) } : { lead: text, rest: "" };
};

const dateFmt = new Intl.DateTimeFormat(i18next.language, { month: "short", year: "numeric" });
const fmt = (ym: string): string => dateFmt.format(new Date(`${ym}-01T00:00:00`));
---

<section id="experience" aria-labelledby="exp-title">
  <div class="container">
    <div class="section-head">
      <h2 id="exp-title">{t("exp.title")}</h2>
    </div>
    <!-- Collapsed by default when there are more than 3 roles: the 2 latest show,
         the 3rd fades out, and the toggle below reveals the rest (site.ts). -->
    <ol class={`timeline${roles.length > 3 ? " is-collapsed" : ""}`} id="exp-timeline" role="list">
      {roles.map((role) => (
        <li class="tl-item">
          <div class="tl-date">{fmt(role.start)} — {role.end ? fmt(role.end) : t("exp.present")}</div>
          <div class="tl-role">
            <div class="top">
              <h3>{t(role.titleKey)}</h3>
              <span class="company">{role.company}</span>
            </div>
            <p class="company-context">{t(role.contextKey)}</p>
            {(() => {
              const { lead, rest } = splitLead(t(role.coreKey));
              return (
                <>
                  <p class="role-core">{lead}</p>
                  {rest && (
                    <details class="role-more">
                      <summary>
                        <span class="role-more__open">{t("exp.more")}</span>
                        <span class="role-more__close">{t("exp.less")}</span>
                      </summary>
                      <p class="role-core">{rest}</p>
                    </details>
                  )}
                </>
              );
            })()}
          </div>
          <div class="tl-stack">
            <h4 class="tl-stack-title">{t("exp.stack")}</h4>
            <ul class="tl-stack-list" role="list">
              {role.techs.map((tech) => {
                const icon = TECH_ICONS[tech];
                return (
                  <li class="tl-stack-item">
                    {icon && (
                      <svg class="tl-stack-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d={icon.path} />
                      </svg>
                    )}
                    <span>{tech}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      ))}
    </ol>
    {roles.length > 3 && (
      <div class="tl-toggle-row">
        <button
          type="button"
          class="tl-toggle"
          data-tl-toggle
          aria-controls="exp-timeline"
          aria-expanded="false"
          data-label-more={`${t("exp.showAll")} (${roles.length})`}
          data-label-less={t("exp.showLess")}
        >
          {t("exp.showAll")} ({roles.length})
        </button>
      </div>
    )}
  </div>
</section>
