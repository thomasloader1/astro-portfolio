---
import Badge from "../../components/Badge.astro";
import SocialPill from "../../components/SocialPill.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../ui/Icon.astro";
// import {t} from 'i18next';
---

<!-- Hero Section -->
<section id="hero" class="min-h-screen flex items-center justify-center px-4 bg-gradient-to-br from-orange-50 via-white to-gray-50 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900">
  <div class="max-w-4xl mx-auto text-center">
    
    <!-- Main Heading -->
    <div class="mb-8">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 text-black dark:text-white leading-tight">
        <span class="block mb-2">Hola, soy Tomás</span>
        <span class="text-orange-500">Consultor Técnico</span>
        <span class="block text-2xl md:text-3xl lg:text-4xl mt-4 text-gray-600 dark:text-gray-300 font-medium">
          para Startups Tecnológicas
        </span>
      </h1>
      
      <!-- Badge -->
      <div class="flex justify-center mb-8">
        <Badge class="text-sm lg:text-base">
          <svg class="inline-block w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          Disponible para consultoría estratégica
        </Badge>
      </div>
    </div>

    <!-- Description -->
    <div class="mb-10">
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
        Ayudo a startups a construir <strong>arquitecturas escalables</strong>, 
        <strong>optimizar performance</strong> y definir <strong>estrategias tecnológicas</strong> 
        que impulsan el crecimiento sostenible
      </p>
    </div>

    <!-- Value Proposition -->
    <div class="grid md:grid-cols-3 gap-6 mb-10 max-w-3xl mx-auto">
      <div class="text-center p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-orange-500 mb-2">5+</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Años de experiencia</div>
      </div>
      <div class="text-center p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-orange-500 mb-2">20+</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Proyectos exitosos</div>
      </div>
      <div class="text-center p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-orange-500 mb-2">40%</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Reducción costos promedio</div>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <Button 
        variant="primary" 
        size="lg"
        href="#contact"
        class="text-lg px-8 py-4"
      >
        <svg class="inline-block w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Agendar consulta gratuita (30min)
      </Button>
      <Button 
        variant="outline" 
        size="lg"
        href="#services"
        class="text-lg px-8 py-4"
      >
        Ver servicios
      </Button>
    </div>

    <!-- Social Links -->
    <div class="flex flex-col items-center space-y-4">
      <p class="text-sm text-gray-500 dark:text-gray-400">Conectemos</p>
      <nav class="flex gap-3 flex-wrap justify-center">
        <SocialPill href="https://linkedin.com/in/gomeztomasgonzalo">
          <Icon name="linkedin" class="size-4 lg:size-5"/> LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/thomasloader1">
          <Icon name="github" class="size-4 lg:size-5" /> GitHub
        </SocialPill>
        <SocialPill href="mailto:talk.gtg@gmail.com">
          <Icon name="mail" class="size-4 lg:size-5" /> talk.gtg@gmail.com
        </SocialPill>
      </nav>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Explora más</p>
      <div class="animate-bounce">
        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </div>
    </div>
  </div>
</section>