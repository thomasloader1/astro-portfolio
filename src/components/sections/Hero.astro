---
import { t } from "i18next";
---

<section class="hero" aria-label={t("hero.ariaSection")}>
  <div class="container">
    <div class="hero-content">

      <div class="hero-identity">
        <img src="https://avatars.githubusercontent.com/u/42984450?v=4" alt="" class="hero-avatar" width="160" height="160">
        <div class="hero-identity__text">
          <h1><span class="hero-name">{t("hero.name")}</span></h1>
        <span class="eyebrow">{t("hero.role")}</span>
        </div>
      </div>
      <p class="hero-lede">{t("hero.lede")}</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">{t("hero.ctaContact")}</a>
        <a href="#projects" class="btn btn-ghost">{t("hero.ctaProjects")}</a>

      </div>
      <div class="stat-row" aria-label={t("hero.ariaStats")}>
        <div class="stat">
          <span class="num">6<span class="unit">+</span></span>
          <span class="label">{t("hero.stat1")}</span>
        </div>

        <div class="stat">
          <span class="num">30<span class="unit">+</span></span>
          <span class="label">{t("hero.stat3")}</span>
        </div>
      </div>
    </div>
  </div>
</section>
