---
import { t } from "i18next";

interface ContactLink {
  href: string;
  labelKey: string;
  value: string;
  target?: string;
}

const links: ContactLink[] = [
  { href: "https://linkedin.com/in/gomeztomasgonzalo", labelKey: "contact.kLinkedIn", value: "gomeztomasgonzalo", target: "_blank" },
  { href: "https://github.com/thomasloader1", labelKey: "contact.kGitHub", value: "thomasloader1", target: "_blank" },
];
---

<section id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact">
      <div>
        <span class="eyebrow">{t("contact.eyebrow")}</span>
        <h2 id="contact-title">{t("contact.title")} <span class="editorial">{t("contact.titleAccent")}</span>.</h2>
        <p>{t("contact.desc")}</p>
      </div>
      <div class="contact-actions">
        {links.map((link) => (
          <a href={link.href} class="contact-link" {...(link.target ? { target: link.target, rel: "noopener" } : {})}>
            <span class="label">
              <span class="k">{t(link.labelKey)}</span>
              <span class="v">{link.value}</span>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
        <button class="btn btn-primary" data-modal="contact" type="button">
          {t("contact.ctaButton")}
        </button>
      </div>
    </div>
  </div>

  <!-- Contact Modal -->
  <dialog id="contact-modal" aria-labelledby="contact-modal-title" aria-modal="true">
    <form id="contact-form" method="dialog" novalidate>
      <header class="contact-modal__header">
        <h3 id="contact-modal-title" data-i18n="contact.modal.title">{t("contact.modal.title")}</h3>
        <p class="contact-modal__subtitle" data-i18n="contact.modal.subtitle">{t("contact.modal.subtitle")}</p>
        <button type="button" class="contact-modal__close" data-modal-close aria-label={t("contact.modal.close")}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>

      <div class="contact-modal__body">
        <div class="contact-modal__field">
          <label for="contact-name" data-i18n-label="contact.modal.form.name">{t("contact.modal.form.name")}</label>
          <input type="text" id="contact-name" name="name" required placeholder={t("contact.modal.form.name")} autocomplete="name" aria-describedby="contact-name-error" />
          <span id="contact-name-error" class="contact-modal__error" data-contact-error="name" aria-live="polite" hidden></span>
        </div>

        <div class="contact-modal__field">
          <label for="contact-email" data-i18n-label="contact.modal.form.email">{t("contact.modal.form.email")}</label>
          <input type="email" id="contact-email" name="email" required placeholder={t("contact.modal.form.email")} autocomplete="email" aria-describedby="contact-email-error" />
          <span id="contact-email-error" class="contact-modal__error" data-contact-error="email" aria-live="polite" hidden></span>
        </div>

        <div class="contact-modal__field">
          <label for="contact-type" data-i18n-label="contact.modal.form.type">{t("contact.modal.form.type")}</label>
          <select id="contact-type" name="contactType" required aria-describedby="contact-type-error">
            <option value="" disabled selected hidden data-i18n="contact.modal.form.typePlaceholder">{t("contact.modal.form.typePlaceholder")}</option>
            <option value="hire" data-i18n="contact.modal.form.types.hire">{t("contact.modal.form.types.hire")}</option>
            <option value="work" data-i18n="contact.modal.form.types.work">{t("contact.modal.form.types.work")}</option>
            <option value="mentoring" data-i18n="contact.modal.form.types.mentoring">{t("contact.modal.form.types.mentoring")}</option>
            <option value="support" data-i18n="contact.modal.form.types.support">{t("contact.modal.form.types.support")}</option>
          </select>
          <span id="contact-type-error" class="contact-modal__error" data-contact-error="contactType" aria-live="polite" hidden></span>
        </div>

        <div class="contact-modal__field">
          <label for="contact-message" data-i18n-label="contact.modal.form.message">{t("contact.modal.form.message")}</label>
          <textarea id="contact-message" name="message" required rows="4" placeholder={t("contact.modal.form.message")} aria-describedby="contact-message-error"></textarea>
          <span id="contact-message-error" class="contact-modal__error" data-contact-error="message" aria-live="polite" hidden></span>
        </div>

        <div class="contact-modal__actions">
          <button type="submit" class="btn btn-primary contact-modal__submit" data-contact-submit>
            <span class="contact-modal__submit-text" data-i18n="contact.modal.form.submit">{t("contact.modal.form.submit")}</span>
            <span class="contact-modal__submit-loading" data-contact-loading hidden data-i18n="contact.modal.form.submitting">{t("contact.modal.form.submitting")}</span>
          </button>
        </div>

        <div class="contact-modal__status" data-contact-success hidden aria-live="polite"></div>
      </div>
    </form>
  </dialog>
</section>
