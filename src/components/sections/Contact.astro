---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { t } from "i18next";
---

<section id="contact" class="py-16 lg:py-24 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-screen-xl mx-auto px-4">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4 text-black dark:text-white">
        {t("contact.title")}
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        {t("contact.subtitle")}
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
      
      <!-- Contact Form -->
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
        <h3 class="text-xl font-semibold mb-6 text-black dark:text-white">
          {t("contact.form.submit")}
        </h3>
        
        <form id="contact-form" class="space-y-6">
          
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              {t("contact.form.name")} *
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent dark:bg-gray-700 dark:text-white"
              placeholder="Tu nombre completo"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              {t("contact.form.email")} *
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent dark:bg-gray-700 dark:text-white"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Company -->
          <div>
            <label for="company" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              {t("contact.form.company")}
            </label>
            <input 
              type="text" 
              id="company" 
              name="company"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent dark:bg-gray-700 dark:text-white"
              placeholder="Nombre de tu startup"
            />
          </div>

          <!-- Team Size -->
          <div>
            <label for="team-size" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              {t("contact.form.size")}
            </label>
            <select 
              id="team-size" 
              name="teamSize"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent dark:bg-gray-700 dark:text-white"
            >
              <option value="">Seleccionar...</option>
              <option value="1-2">1-2 personas</option>
              <option value="3-10">3-10 personas</option>
              <option value="11-25">11-25 personas</option>
              <option value="26-50">26-50 personas</option>
              <option value="50+">50+ personas</option>
            </select>
          </div>

          <!-- Budget -->
          <div>
            <label for="budget" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              {t("contact.form.budget")}
            </label>
            <select 
              id="budget" 
              name="budget"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent dark:bg-gray-700 dark:text-white"
            >
              <option value="">Seleccionar rango...</option>
              <option value="1000-5000">USD 1,000 - 5,000</option>
              <option value="5000-10000">USD 5,000 - 10,000</option>
              <option value="10000-20000">USD 10,000 - 20,000</option>
              <option value="20000+">USD 20,000+</option>
              <option value="discuss">A discutir</option>
            </select>
          </div>

          <!-- Project Description -->
          <div>
            <label for="project" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              {t("contact.form.project")} *
            </label>
            <textarea 
              id="project" 
              name="project" 
              rows="4" 
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent dark:bg-gray-700 dark:text-white resize-none"
              placeholder="Describe tu proyecto y los desafíos que enfrentas..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <Button 
            variant="primary" 
            size="lg"
            type="submit"
            class="w-full"
          >
            <Icon name="check-circle" class="size-5 mr-2" />
            {t("contact.form.submit")}
          </Button>
        </form>

        <!-- Success/Error Messages -->
        <div id="form-success" class="hidden mt-4 p-4 bg-green-100 dark:bg-green-900 border border-green-300 dark:border-green-700 rounded-lg text-green-800 dark:text-green-200">
          {t("contact.form.success")}
        </div>
        <div id="form-error" class="hidden mt-4 p-4 bg-red-100 dark:bg-red-900 border border-red-300 dark:border-red-700 rounded-lg text-red-800 dark:text-red-200">
          {t("contact.form.error")}
        </div>
      </div>

      <!-- Calendar & Quick Contact -->
      <div class="space-y-8">
        
        <!-- Calendar CTA -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
          <h3 class="text-xl font-semibold mb-4 text-black dark:text-white">
            {t("contact.calendar.title")}
          </h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            {t("contact.calendar.description")}
          </p>
          
          <Button 
            variant="primary" 
            size="lg"
            href="https://calendly.com/yourusername/30min"
            target="_blank"
            class="w-full"
          >
            <Icon name="calendar" class="size-5 mr-2" />
            Agendar llamada 30 min
          </Button>
        </div>

        <!-- Quick Contact Info -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 border border-gray-200 dark:border-gray-700">
          <h3 class="text-xl font-semibold mb-6 text-black dark:text-white">
            Otras formas de contacto
          </h3>
          
          <div class="space-y-4">
            <!-- Email -->
            <div class="flex items-center">
              <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-black dark:text-white">Email</div>
                <a href="mailto:talk.gtg@gmail.com" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300">
                  talk.gtg@gmail.com
                </a>
              </div>
            </div>

            <!-- LinkedIn -->
            <div class="flex items-center">
              <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-black dark:text-white">LinkedIn</div>
                <a href="https://linkedin.com/in/gomeztomasgonzalo" target="_blank" rel="noopener noreferrer" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300">
                  Conectar profesionalmente
                </a>
              </div>
            </div>

            <!-- Response Time -->
            <div class="mt-6 p-4 bg-orange-50 dark:bg-orange-900/20 rounded-lg border border-orange-200 dark:border-orange-800">
              <div class="flex items-center">
                <Icon name="clock" class="size-5 text-orange-600 dark:text-orange-400 mr-2" />
                <span class="text-sm font-medium text-orange-800 dark:text-orange-200">
                  Tiempo de respuesta: 24-48 horas
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Form functionality will be implemented with backend integration -->