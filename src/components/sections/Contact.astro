---
import i18next, { t } from "i18next";

interface ContactLink {
  href: string;
  labelKey: string;
  value: string;
  target?: string;
}

const links: ContactLink[] = [
  { href: "mailto:talk.gtg@gmail.com", labelKey: "contact.kEmail", value: "talk.gtg@gmail.com" },
  { href: "https://linkedin.com/in/gomeztomasgonzalo", labelKey: "contact.kLinkedIn", value: "gomeztomasgonzalo", target: "_blank" },
  { href: "https://github.com/thomasloader1", labelKey: "contact.kGitHub", value: "thomasloader1", target: "_blank" },
  { href: "https://gomeztomasgonzalo.com.ar", labelKey: "contact.kWeb", value: "gomeztomasgonzalo.com.ar", target: "_blank" },
  { href: "tel:+541155011250", labelKey: "contact.kPhone", value: "+54 11 5501-1250" },
];
---

<section id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact">
      <div>
        <span class="eyebrow">{t("contact.eyebrow")}</span>
        <h2 id="contact-title">{i18next.language === "es" ? "Trabajemos" : "Let's work"} <span class="editorial">{t("contact.titleAccent")}</span>{i18next.language === "es" ? "." : " together."}</h2>
        <p>{t("contact.desc")}</p>
      </div>
      <div class="contact-actions">
        {links.map((link) => (
          <a href={link.href} class="contact-link" {...(link.target ? { target: link.target, rel: "noopener" } : {})}>
            <span class="label">
              <span class="k">{t(link.labelKey)}</span>
              <span class="v">{link.value}</span>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
