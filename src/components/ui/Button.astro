---
export interface Props {
    variant?: 'primary' | 'secondary' | 'outline';
    size?: 'sm' | 'md' | 'lg';
    href?: string;
    target?: string;
    rel?: string;
    type?: 'button' | 'submit' | 'reset';
    disabled?: boolean;
    ariaLabel?: string;
    ariaExpanded?: boolean;
    ariaHasPopup?: boolean | 'menu' | 'listbox' | 'tree' | 'grid' | 'dialog';
    class?: string;
}

const {
    variant = 'primary',
    size = 'md',
    href,
    target,
    rel,
    type = 'button',
    disabled = false,
    ariaLabel,
    ariaExpanded,
    ariaHasPopup,
    class: additionalClasses = ''
} = Astro.props;

// Base classes
const baseClasses = 'inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus-visible:ring-2 focus-visible:ring-orange-400 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed';

// Variant classes
const variantClasses = {
    primary: 'bg-orange-400 text-white hover:bg-orange-500 focus-visible:bg-orange-500',
    secondary: 'bg-gray-600 text-white hover:bg-gray-700 focus-visible:bg-gray-700 dark:bg-gray-700 dark:hover:bg-gray-600 dark:focus-visible:bg-gray-600',
    outline: 'border-2 border-orange-400 text-orange-400 hover:bg-orange-400 hover:text-white focus-visible:bg-orange-400 focus-visible:text-white dark:border-orange-300 dark:text-orange-300 dark:hover:border-orange-300'
};

// Size classes
const sizeClasses = {
    sm: 'px-3 py-1.5 text-sm',
    md: 'px-4 py-2 text-sm',
    lg: 'px-6 py-3 text-base'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${additionalClasses}`;
---

{
    href ? (
        <a 
            href={href} 
            target={target} 
            rel={rel || (href?.startsWith('http') ? 'noopener noreferrer' : undefined)}
            class={classes}
            aria-label={ariaLabel}
            aria-expanded={ariaExpanded}
            aria-haspopup={ariaHasPopup}
        >
            <slot />
        </a>
    ) : (
        <button 
            type={type}
            class={classes}
            disabled={disabled}
            aria-label={ariaLabel}
            aria-expanded={ariaExpanded}
            aria-haspopup={ariaHasPopup}
        >
            <slot />
        </button>
    )
}