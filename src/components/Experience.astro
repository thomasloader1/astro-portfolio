---
import ExperiencieItem from "./ExperiencieItem.astro";
import Button from "./ui/Button.astro";
import { EXPERIENCES } from "../data/Experience.ts";
import ShovelIcon from "../icons/Shovel.astro";
import { t } from "i18next";
---

<h2
    class="text-2xl font-semibold mb-6 flex gap-x-2 items-center text-black dark:text-white"
>
    <ShovelIcon class="size-6" />
    {t("experience.title")}
</h2>
<div class="flex justify-center">
    <ol class="relative border-s border-gray-200 dark:border-gray-700">
        {
            EXPERIENCES.map((experience) => (
                <li class={`mb-10 ms-6`}>
                    <ExperiencieItem {...experience} />
                </li>
            ))
        }
    </ol>
</div>
<div class="flex justify-center mt-12">
    <div class="text-center">
        <h3 class="text-xl font-semibold mb-4 text-black dark:text-white">
            ¿Necesitas ayuda con un proyecto similar?
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-lg">
            Con mi experiencia en diferentes industrias y tecnologías, 
            puedo ayudarte a evitar errores comunes y acelerar tu desarrollo.
        </p>
        <Button 
            variant="primary" 
            size="lg"
            href="#contact"
        >
            Agendar consulta sobre mi proyecto
        </Button>
    </div>
</div>
